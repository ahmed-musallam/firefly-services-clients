{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "extends": "nx/presets/npm.json",
  "tui": {
    "enabled": false
  },
  "targetDefaults": {
    "codegen": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/spec/**/*.json",
        "{projectRoot}/orval.config.ts",
        "{workspaceRoot}/orval.config.base.ts"
      ],
      "outputs": ["{projectRoot}/src/generated"],
      "options": {
        "command": "orval --config orval.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "^build",
        "codegen",
        {
          "target": "build",
          "projects": ["@musallam/ims-client"]
        }
      ],
      "inputs": ["production", "^production"],
      "cache": true,
      "outputs": ["{projectRoot}/dist"]
    },
    "docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "typedoc --tsconfig tsconfig.json --out ../../typedoc/{projectName} src/index.ts",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/typedoc.json",
        "{workspaceRoot}/tsdoc.json"
      ],
      "outputs": ["{workspaceRoot}/typedoc/{projectName}"]
    },
    "type-check": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "codegen",
        {
          "target": "build",
          "projects": ["@musallam/ims-client"]
        }
      ],
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["production", "^production"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src --ignore-pattern 'src/generated' --max-warnings 0",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/eslint.config.mjs", "{workspaceRoot}/.eslintignore"],
      "outputs": []
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write \"src/**/*.{ts,json,md}\"",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.prettierrc", "{workspaceRoot}/.prettierignore"],
      "outputs": []
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --check \"src/**/*.{ts,json,md}\"",
        "cwd": "packages/firefly-client"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.prettierrc", "{workspaceRoot}/.prettierignore"],
      "outputs": []
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"]
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/spec/**/*.json"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/vite.config.base.ts",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/orval.config.base.ts"
    ]
  },
  "generators": {
    "@nx/js:library": {
      "buildable": true,
      "bundler": "vite"
    }
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": [
          "build",
          "type-check",
          "lint",
          "format",
          "format:check",
          "test",
          "docs"
        ]
      }
    }
  },
  "parallel": 3,
  "cacheDirectory": ".nx/cache",
  "release": {
    "projects": ["packages/*"],
    "projectsRelationship": "independent",
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": "github",
        "file": "{projectRoot}/CHANGELOG.md",
        "entryWhenNoChanges": false,
        "renderOptions": {
          "authors": false
        }
      }
    },
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk"
    },
    "git": {
      "commit": true,
      "tag": true,
      "push": true,
      "commitMessage": "chore(release): publish {version}",
      "tagMessage": "{projectName}@{version}"
    }
  }
}
