{
  "name": "@musallam/firefly-services-clients",
  "version": "2.4.0",
  "description": "TypeScript client library for Adobe Firefly Services API",
  "type": "module",
  "workspaces": [
    "packages/*",
    "samples"
  ],
  "scripts": {
    "fetch-spec": "npx ts-node build-scripts/fetch-spec.ts",
    "codegen": "nx run-many -t codegen",
    "build": "nx run-many -t build",
    "build:affected": "nx affected -t build",
    "dev": "npm run build --watch",
    "docs": "nx run-many -t docs && node build-scripts/generate-docs-index.js",
    "docs:affected": "nx affected -t docs",
    "type-check": "nx run-many -t type-check",
    "lint": "nx run-many -t lint",
    "lint:affected": "nx affected -t lint",
    "format": "nx run-many -t format",
    "format:affected": "nx affected -t format",
    "format:check": "nx run-many -t format:check",
    "format:check:affected": "nx affected -t format:check",
    "test": "echo \"No tests yet\" && exit 0",
    "prepare": "husky",
    "clean": "rm -rf packages/*/dist typedoc .nx/cache",
    "nx:graph": "nx graph",
    "nx:reset": "nx reset",
    "release": "nx release",
    "release:version": "nx release version",
    "release:publish": "nx release publish"
  },
  "keywords": [
    "adobe",
    "firefly",
    "firefly-api",
    "generative-ai",
    "typescript",
    "sdk",
    "client"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmed-musallam/adobe-services-clients.git"
  },
  "bugs": {
    "url": "https://github.com/ahmed-musallam/adobe-services-clients/issues"
  },
  "homepage": "https://github.com/ahmed-musallam/adobe-services-clients#readme",
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.38.0",
    "@nx/js": "22.0.2",
    "@nx/vite": "22.0.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.38.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "nx": "22.0.2",
    "orval": "^7.14.0",
    "prettier": "^3.2.0",
    "semantic-release": "^23.0.0",
    "typedoc": "^0.28.14",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.46.2",
    "vite": "npm:rolldown-vite@7.1.14",
    "vite-plugin-dts": "^4.5.4"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "dotenv": "^17.2.3"
  }
}
