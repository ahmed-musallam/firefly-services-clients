{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,

    /* Library mode */
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    /* Path mappings for workspace packages */
    "paths": {
      "@musallam/ims-client": ["./packages/ims-client/src"],
      "@musallam/firefly-client": ["./packages/firefly-client/src"],
      "@musallam/photoshop-client": ["./packages/photoshop-client/src"],
      "@musallam/storage-and-collaboration-client": [
        "./packages/storage-and-collaboration-client/src"
      ]
    }
  },
  "include": ["src", "build-scripts/spec-urls.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
